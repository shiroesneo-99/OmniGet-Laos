{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omniget",
  "version": "0.9.2",
  "identifier": "wtf.tonho.omniget",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OmniGet",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1C1C1E"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval' https://sdk.scdn.co",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: http: wss: ws:",
        "frame-src": "'self' asset: http://asset.localhost blob: https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": [],
          "requireLiteralLeadingDot": false
        }
      }
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyRDQ3MkEyNzQwM0QyM0IKUldRNzBnTjBvbkxVb3R6YmNheHNEbWNGZktST0k4dmVEZ1h2dE9mUGtSMityVHJPNmpPK2dEaWYK",
      "endpoints": [
        "https://github.com/shiroesneo-99/OmniGet-Laos/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "omniget"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../browser-extension/chrome/": "browser-extension/chrome/",
      "../browser-extension/firefox/": "browser-extension/firefox/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ],
        "desktopTemplate": "./desktop.template"
      },
      "rpm": {
        "desktopTemplate": "./desktop.template"
      }
    }
  }
}